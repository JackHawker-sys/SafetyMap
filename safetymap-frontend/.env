# URL backend Spring, KHÔNG có dấu / ở cuối
VITE_API_BASE_URL=http://localhost:8080

# Dịch vụ gợi ý địa chỉ
VITE_GEOCODER_URL=https://photon.komoot.io/api/

# Style bản đồ MapLibre (đường dẫn trong public/ hoặc URL đầy đủ)
VITE_MAP_STYLE_URL=/map/openfreemap_liberty_vn.json

# true = đọc public/db.json, false = gọi backend
VITE_USE_MOCK_DATA=true

# true = bật công cụ vẽ road_segment bằng click (chỉ chạy ở dev, tắt chức năng ghim điểm)
VITE_ENABLE_COORD_PICKER=false

